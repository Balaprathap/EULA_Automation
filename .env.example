# =============================================================================
# ClauseGuard - Automated EULA Compliance Extraction
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# --- Frontend (browser-exposed; only safe public values may use NEXT_PUBLIC_) --
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Supabase (backend only) --------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVER-ONLY. Never expose to browser code. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_REPORTS_BUCKET=reports

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clauseguard

# --- Queue / cache ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Anthropic (text generation only; Anthropic has no embeddings API) --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=4
# USD per 1M tokens - verify against current Anthropic pricing before relying on cost figures.
ANTHROPIC_INPUT_COST_PER_MTOK=3.00
ANTHROPIC_CACHED_INPUT_COST_PER_MTOK=0.30
ANTHROPIC_OUTPUT_COST_PER_MTOK=15.00

# --- Embeddings (separate provider from Anthropic) ----------------------------
# openai | voyage | deterministic  (deterministic is for tests/CI only)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_COST_PER_MTOK=0.02

# --- URLs / CORS --------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
# Comma-separated allowlist (a JSON array also works).
# MUST NOT be "*" in production - startup will refuse to proceed.
CORS_ORIGINS=http://localhost:3000

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_DOCUMENT_PAGES=150
MAX_TOOL_CALLS_PER_CATEGORY=5
RETRIEVAL_TOP_K=8
RATE_LIMIT_ANALYSES_PER_HOUR=20
RATE_LIMIT_REQUESTS_PER_MINUTE=200

# --- Report email delivery ----------------------------------------------------
# console | smtp | resend.  "console" logs a redacted line and sends nothing,
# so the feature degrades safely when no provider is configured.
EMAIL_PROVIDER=console
EMAIL_FROM=ClauseGuard <noreply@example.com>
EMAIL_REPLY_TO=
# Attachments larger than this are replaced by a short-lived secure link.
EMAIL_MAX_ATTACHMENT_MB=8
EMAIL_MAX_ATTEMPTS=3

# EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# EMAIL_PROVIDER=resend
RESEND_API_KEY=

REPORT_SIGNED_URL_TTL_SECONDS=900
RATE_LIMIT_REPORT_EMAILS_PER_HOUR=10

# --- AWS (optional, additive; both flags default to false) --------------------
# ClauseGuard runs entirely on Supabase storage and the existing email providers
# until these are enabled. Credentials come from the deployment IAM role or the
# standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables - never from here.
AWS_REGION=us-east-1
AWS_S3_REPORT_BUCKET=
AWS_REPORT_STORAGE_ENABLED=false
AWS_KMS_KEY_ID=
AWS_SES_ENABLED=false
AWS_SES_FROM_EMAIL=
AWS_SES_CONFIGURATION_SET=
AWS_REPORT_URL_TTL_SECONDS=900
AWS_REPORT_ATTACHMENT_MAX_BYTES=8388608

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
ENVIRONMENT=development
